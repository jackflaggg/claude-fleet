# claude-fleet - шаблон конфигурации. Скопируй в .env:  cp .env.example .env
# Реальный .env в .gitignore и наружу не уходит.

# Порт локального сервера борда. Должен совпадать с тем, что читает hooks/report.sh
# (репортер берёт порт из этого же файла).
FLEET_PORT=4319

# Хост привязки. Оставь 127.0.0.1 - борд только для локалхоста.
FLEET_HOST=127.0.0.1

# Дополнительные значения заголовка Host, которым разрешено обращаться к борду, через запятую.
# Нужно, только если смотришь борд не с этой машины (например с планшета: 192.168.1.10:4319).
# Пустое значение = только localhost. Проверка Host закрывает DNS rebinding: без неё
# страница в браузере может прочитать /stream, а там все промпты и пути проектов.
FLEET_ALLOWED_HOSTS=

# Через сколько часов простоя карточка считается протухшей при восстановлении с диска.
FLEET_STALE_HOURS=6

# Абсолютный путь к CLI-лаунчеру WebStorm (на разных машинах разный: /usr/local vs homebrew).
# Найти свой: which webstorm
FLEET_WEBSTORM=/usr/local/bin/webstorm

# Имя приложения для фолбэка `open -a <app>`, если лаунчер по пути выше не найден.
FLEET_WEBSTORM_APP=WebStorm
