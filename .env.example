# Fleet - шаблон конфигурации Claude Code + Codex. Скопируй в .env:  cp .env.example .env
# Реальный .env в .gitignore и наружу не уходит.

# Порт локального сервера борда. Должен совпадать с тем, что читает hooks/report.sh
# (репортер берёт порт из этого же файла).
FLEET_PORT=4319

# Хост привязки. Оставь 127.0.0.1 - борд только для локалхоста.
FLEET_HOST=127.0.0.1

# Дополнительные значения заголовка Host, которым разрешено обращаться к борду, через запятую.
# Нужно, только если смотришь борд не с этой машины (например с планшета: 192.168.1.10:4319).
# Пустое значение = только localhost. Проверка Host закрывает DNS rebinding: без неё
# страница в браузере может прочитать /stream, а там все промпты и пути проектов.
FLEET_ALLOWED_HOSTS=

# Токен доверия для запросов не с этой машины. Пусто = выключено: из сети пускает любого,
# чей Host есть в FLEET_ALLOWED_HOSTS (то есть /stream со всеми промптами читает каждый в LAN).
# Задан - с планшета борд открывается один раз по ссылке http://<host>:4319/?token=<значение>,
# сервер ставит cookie (HttpOnly, SameSite=Strict) и уводит на /, дальше без токена в адресе.
# Без cookie любой маршрут отвечает 403. Loopback (эта машина, хуки, канал) доверен всегда.
# Сгенерировать: openssl rand -hex 16
FLEET_TOKEN=

# Через сколько часов простоя карточка считается протухшей при восстановлении с диска.
FLEET_STALE_HOURS=6

# Через сколько минут простоя убирается ПУСТАЯ карточка - та, что за всю жизнь не показала
# ни задачи, ни инструмента: фоновый агент со своим session_id, остаток от перехода
# в git-worktree, брошенная сессия. Ждать по ней полные FLEET_STALE_HOURS незачем: сказать
# ей нечего, а на первом же настоящем событии она вернётся.
FLEET_BLANK_MINUTES=15

# Папка транскриптов Claude Code: по ним считается окно лимита в шапке борда.
# Пусто/не задано = ~/.claude/projects. Наружу ничего не уходит, файлы только читаются.
FLEET_TRANSCRIPTS=

# До какой границы (в минутах) округляется вниз старт окна лимита. Claude открывает окно
# не по секунде первого запроса, а по ближайшей границе получаса: сверено с /usage - первый
# запрос в 09:34 дал окно 09:30 - 14:30. 0 отключает выравнивание.
FLEET_USAGE_ALIGN_MIN=30

# Длина окна лимита в часах. Пять - текущее скользящее окно тарифа; это не наша настройка,
# а свойство подписки, поэтому вынесено сюда: поменяют тариф - поправишь одну строку.
FLEET_USAGE_HOURS=5

# Абсолютный путь к CLI-лаунчеру WebStorm (на разных машинах разный: /usr/local vs homebrew).
# Найти свой: which webstorm
FLEET_WEBSTORM=/usr/local/bin/webstorm

# Имя приложения для фолбэка `open -a <app>`, если лаунчер по пути выше не найден.
FLEET_WEBSTORM_APP=WebStorm

# Открывать окно борда автоматически при входе в систему (отдельный launchd-агент
# <label>-board). 0 - не ставить агент, борд открывать руками через scripts/board.sh.
FLEET_AUTOOPEN=1

# Сколько секунд board.sh ждёт ответа сервера при автозапуске, прежде чем сдаться.
# Дефолт самого скрипта 20, но на холодной загрузке системы node/fnm поднимается дольше
# (в логе бывало 60+ секунд от boottime), поэтому здесь 60. Если борд не открывается сам
# после ребута, смотри fleet.board.log и увеличивай это значение.
FLEET_BOARD_WAIT=60

# Ответ с борда через канал Claude Code (прототип, research preview каналов). 1 включает
# маршруты /channel/* и кнопки «Разрешить»/«Отказать» плюс строку ответа на карточке.
# Сам канал подключается отдельно: install.md, раздел «Ответ с борда» (claude mcp add).
# 0 - борд выглядит и работает как раньше.
FLEET_CHANNEL=0
